# Copy this file to .env and adjust if needed.
#
# SCAN_ROOTS — optional JSON array overriding the default drives.
#   Example: [{"name":"Drive C:","path":"C:\\","displayPath":"C:\\"},{"name":"Drive D:","path":"D:\\","displayPath":"D:\\"}]
# SCAN_ROOTS=

# SCAN_HOST_MOUNT — when running in a container, map host drives to mount paths.
#   JSON object mapping drive letter (lowercase) to container mount path.
#   Example: {"c":"/mnt/c","d":"/mnt/d"}
SCAN_HOST_MOUNT={"c":"/mnt/c","d":"/mnt/d"}

# SCAN_TIMEOUT_MS — total scan budget in milliseconds (all folders share it).
#   Bind mounts are slower than native reads, so the default in
#   docker-compose.yml is 180000 (3 minutes).
SCAN_TIMEOUT_MS=180000