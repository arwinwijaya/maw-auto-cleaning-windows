# Copy this file to .env and adjust if needed.
#
# HOST_USER — your Windows username, used to locate
#             C:\Users\<HOST_USER>\AppData\Local\Temp inside the container.
#             If unset, docker-compose.yml falls back to %USERNAME%.
HOST_USER=

# SCAN_TIMEOUT_MS — total scan budget in milliseconds (all folders share it).
#                  Bind mounts are slower than native reads, so the default in
#                  docker-compose.yml is 180000 (3 minutes).
# SCAN_TIMEOUT_MS=180000

# ===========================================================================
# CLEANUP TARGETS — opt-in read-write mounts.
#
# Every /cleanup/<target> mount defaults to ./test-data/<target>, which is a
# safe throwaway fixture. Point a variable at a REAL cache directory only
# after you have reviewed it and are ready to let the cleaner delete files
# inside it (older than 24h, never the root itself, never browser profiles).
#
# Example:
#   CLEANUP_LOCAL_TEMP=C:\Users\you\AppData\Local\Temp
#   CLEANUP_CHROME_CACHE=C:\Users\you\AppData\Local\Google\Chrome\User Data\Default\Cache
# ===========================================================================
# CLEANUP_LOCAL_TEMP=
# CLEANUP_WINDOWS_TEMP=
# CLEANUP_D_TEMP=
# CLEANUP_NPM_CACHE=
# CLEANUP_UV_CACHE=
# CLEANUP_PIP_CACHE=
# CLEANUP_CHROME_CACHE=
# CLEANUP_EDGE_CACHE=
# CLEANUP_DIRECTX_CACHE=
# CLEANUP_CRASH_DUMPS=
